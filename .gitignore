# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# FLUX PHP Backend Credentials & Uploads
api/config.php
public/api/config.php
uploads/bom/*
!uploads/bom/.htaccess
public/uploads/bom/*
