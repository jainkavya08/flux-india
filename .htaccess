# ==============================================================================
# FLUX India — Root Apache Configuration (.htaccess)
# Designed for Static Next.js Export + PHP API on InfinityFree (Apache)
# ==============================================================================

# Set default directory index files
DirectoryIndex index.html index.php

# Disable directory browsing across all folders
Options -Indexes

# ------------------------------------------------------------------------------
# Security Headers (Applied safely when mod_headers is available)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------------------------
# Block Direct Access to Sensitive Files, Backups, and Hidden Files
# ------------------------------------------------------------------------------
<FilesMatch "(^\.|\.(env|sql|bak|log|md|json|ts|tsx)$)">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Deny from all
    </IfModule>
</FilesMatch>

# Allow manifest.json, robots.txt, sitemap.xml if requested directly
<FilesMatch "^(manifest\.json|robots\.txt|sitemap\.xml)$">
    <IfModule authz_core_module>
        Require all granted
    </IfModule>
    <IfModule !authz_core_module>
        Allow from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# URL Rewriting & Clean URL Routing
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Allow existing files and directories to be served directly
    #    (Passes through static JS/CSS, images, /api/*.php, /admin/, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Map extensionless routes to corresponding directory index.html
    #    e.g. /about -> /about/index.html, /contact -> /contact/index.html,
    #         /bom -> /bom/index.html, /solutions -> /solutions/index.html
    RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
    RewriteRule ^(.*)/?$ $1/index.html [L,QSA]

    # 3. Fallback: Map extensionless route to .html file if present
    #    e.g. /about -> /about.html
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)/?$ $1.html [L,QSA]

</IfModule>

# Custom error pages
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
